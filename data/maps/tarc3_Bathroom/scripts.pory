mapscripts tarc3_Bathroom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: tarc3_Bathroom_OnTransition
    MAP_SCRIPT_ON_LOAD: tarc3_Bathroom_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_ACT2, TARC3_ACT2_BLACKOUT: tarc3_Bathroom_EventScript_BlackoutCut
    ]
}

script tarc3_Bathroom_OnTransition {
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_BLACKOUT) {
        setflashlevel(8)
    } elif (var(VAR_TARC3_ACT2) == TARC3_ACT2_TO_BATHROOM) {
        if (flag(FLAG_TARC3_MAGNEZONE_FLASH)) {
            setflashlevel(4)
        } else {
            setflashlevel(7)
        }
    }
    end
}

script tarc3_Bathroom_OnLoad {
    setflag(FLAG_HIDE_TARC3_BATH_ICHIRO_UP)
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_TO_BATHROOM && var(VAR_TARC3_ACT2) < TARC3_ACT2_TO_ELECTRICAL) {
        clearflag(FLAG_HIDE_TARC3_BATH_ICHIRO_DOWN)
    } else {
        setflag(FLAG_HIDE_TARC3_BATH_ICHIRO_DOWN)
    }
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_ICHIRO_FOUND) {
        clearflag(FLAG_HIDE_TARC3_BATH_CAST)
    } else {
        setflag(FLAG_HIDE_TARC3_BATH_CAST)
    }
    setflag(FLAG_HIDE_TARC3_BATH_FAMILY)
    setflag(FLAG_HIDE_TARC3_BATH_SUZUKI)
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_TO_BATHROOM) {
        call(tarc3_Bathroom_EventScript_Blood)
    }
    end
}

script tarc3_Bathroom_EventScript_Blood {
    setmetatile(7, 8, 0x453, FALSE) // blood spatter 1
    setmetatile(7, 9, 0x45B, FALSE) // blood spatter 2
    setmetatile(7, 10, 0x46F, FALSE) // knife
    return
}

// CS10 (cut to ichiro)

script tarc3_Bathroom_EventScript_BlackoutCut {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(set_invisible))
    waitmovement(0)
    clearflag(FLAG_HIDE_TARC3_BATH_ICHIRO_UP)
    addobject(LOCALID_BATHROOM_ICHIRO_UP)
    delay(20)
    animateflash(6)
    setflashlevel(6)
    delay(30)
    playse(SE_PIN)
    applymovement(LOCALID_BATHROOM_ICHIRO_UP, moves(emote_exclamation_mark))
    waitmovement(0)
    setspeaker("Ichiro")
    msgbox(format("...?!"))
    setspeaker(NULL)
    closemessage
    delay(30)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_HIDE_TARC3_BATH_ICHIRO_UP)
    removeobject(LOCALID_BATHROOM_ICHIRO_UP)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(set_visible))
    waitmovement(0)
    warp(MAP_TARC3_MAIN_DECK, 43, 11)
    waitstate
    end
}

// CS10 (player enters bathroom)

script tarc3_Bathroom_EventScript_IchiroDown {
    lockall
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_ICHIRO_FOUND) {
        goto(tarc3_Bathroom_EventScript_Discovery)
    }
    faceplayer
    setspeaker("Ichiro")
    msgbox(format("I didn't see anything. I'm sorry."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_ICHIRO_FOUND_LIE)) {
        msgbox(format("{FONT_NARROW}(The lights were already out when whoever it was came in. He never saw a thing.)", "1_latin_rse_narrow"))
        closemessage
        giveevidence(EVD_BATHROOM_BLACKOUT)
        closemessage
        setflag(FLAG_TARC3_ICHIRO_FOUND_LIE)
    }
    if (!flag(FLAG_TARC3_ICHIRO_FOUND_LEG)) {
        msgbox(format("The cut is on the outside of his thigh. It is still bleeding into his trouser leg."))
        msgbox(format("{FONT_NARROW}(His hands are clean. No cuts on the palms, nothing on the forearms.)", "1_latin_rse_narrow"))
        msgbox(format("{FONT_NARROW}(He was stabbed in the dark and he never once put a hand up.)", "1_latin_rse_narrow"))
        closemessage
        giveevidence(EVD_INJURED_LEG)
        giveevidence(EVD_NO_DEFENSIVE_WOUNDS)
        closemessage
        setflag(FLAG_TARC3_ICHIRO_FOUND_LEG)
    }
    releaseall
    end
}

script tarc3_Bathroom_EventScript_EvdKnife {
    lockall
    goto_if_set(FLAG_TARC3_BATH_FOUND_KNIFE, tarc3_Bathroom_EventScript_EvdKnifeSeen)
    msgbox(format("A cook's knife on the tiles, off to Ichiro's right. The blade points away from him."))
    msgbox(format("{FONT_NARROW}(Handle nearest his own hand, and barely a stride from where he's sitting.)", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}(An attacker running for the door doesn't set it down at his victim's fingertips.)", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_BATHROOM_KNIFE)
    closemessage
    setflag(FLAG_TARC3_BATH_FOUND_KNIFE)
    releaseall
    end
}

script tarc3_Bathroom_EventScript_EvdKnifeSeen {
    msgbox(format("Joji's knife, lying to Ichiro's right with the handle turned back towards him."))
    releaseall
    end
}

script tarc3_Bathroom_EventScript_Natsue {
    lock
    faceplayer
    setspeaker("Natsue")
    msgbox(format("First Grandfather, then Tatsuo, and now Ichiro.\pWhat is happening on this ship?"))
    setspeaker(NULL)
    release
    end
}

script tarc3_Bathroom_EventScript_Akie {
    lock
    faceplayer
    setspeaker("Akie")
    msgbox(format("Whoever it was walked past all of us. None of us heard a thing."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Bathroom_EventScript_Ran {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) > TARC3_ACT2_ICHIRO_FOUND) {
        setspeaker("{RIVAL}")
        msgbox(format("Go on down with them, {PLAYER}. We've got him."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker("{RIVAL}")
    msgbox(format("Nobody has moved anything. Look at all of it while you can."))
    msgbox(format("Have you seen everything you need in here?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Then take your time. I'll keep them by the door."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker(NULL)
    closemessage
    goto(tarc3_Bathroom_EventScript_DiscoverySuzuki)
}

script tarc3_Bathroom_EventScript_Discovery {
    call(tarc3_Bathroom_EventScript_Blood)
    special(DrawWholeMapView)
    playse(SE_DOOR)
    delay(40)
    clearflag(FLAG_HIDE_TARC3_BATH_CAST)
    clearflag(FLAG_HIDE_TARC3_BATH_FAMILY)
    addobject(LOCALID_BATHROOM_RAN)
    addobject(LOCALID_BATHROOM_NATSUE)
    addobject(LOCALID_BATHROOM_KITARO)
    addobject(LOCALID_BATHROOM_MARIKO)
    addobject(LOCALID_BATHROOM_AKIE)
    addobject(LOCALID_BATHROOM_JOJI)
    delay(20)
    restoretodblend
    playse(SE_M_THUNDERBOLT2)
    animateflash(0)
    setflashlevel(0)
    msgbox(format("{FONT_NARROW}(The lights came back. Suzuki found the breaker.)", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}(Ichiro is on the floor. He's bleeding from his thigh.)", "1_latin_rse_narrow"))
    setspeaker("Natsue")
    msgbox(format("Ichiro! Are you ok?\pWhat happened!?"))
    closemessage
    delay(20)
    applymovement(LOCALID_BATHROOM_KITARO, moves(face_player))
    waitmovement(0)
    setspeaker("Ichiro")
    msgbox(format("The lights went out.\pSomeone came in...\pHe stabbed me!"))
    msgbox(format("I couldn't see him. I couldn't see anything."))
    setspeaker(NULL)
    closemessage
    delay(20)
    // need to identify the knife/evidence?
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_ICHIRO_FOUND)
    applymovement(LOCALID_BATHROOM_KITARO, moves(face_left))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("Joji... Is that your knife?\pWeren't they kept secure in your room?"))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_down * 2))
    waitmovement(0)
    delay(60)
    applymovement(LOCALID_CAMERA, moves(walk_up * 4))
    waitmovement(0)
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_BATHROOM_JOJI, moves(face_right, emote_exclamation_mark))
    waitmovement(0)
    setspeaker("Joji")
    msgbox(format("That is my knife. But it wasn't me!\pI was at the table with all of you when the lights went out!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_BATHROOM_KITARO, moves(face_down))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("...That's true."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_BATHROOM_MARIKO, moves(face_right))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Then there's only one person it could have been."))
    msgbox(format("Only one of us wasn't in that room.\pTakeshi."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("Nobody touch anything. Not until {PLAYER} has looked."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}(Ichiro, the knife, the floor. Then I'll tell {RIVAL} I'm done.)", "1_latin_rse_narrow"))
    closemessage
    applymovement(LOCALID_CAMERA, moves(walk_down * 2))
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
    end
}

script tarc3_Bathroom_EventScript_NoExit {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
    waitmovement(0)
    msgbox(format("{FONT_NARROW}(I'm not leaving this room until I've looked at all of it.)", "1_latin_rse_narrow"))
    releaseall
    end
}

script tarc3_Bathroom_EventScript_DiscoverySuzuki {
    delay(30)
    opendoor(7, 3)
    waitdooranim
    clearflag(FLAG_HIDE_TARC3_BATH_SUZUKI)
    addobject(LOCALID_BATHROOM_SUZUKI)
    applymovement(LOCALID_BATHROOM_SUZUKI, moves(walk_down))
    waitmovement(0)
    closedoor(7, 3)
    waitdooranim
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    applymovement(LOCALID_BATHROOM_RAN, moves(face_up))
    applymovement(LOCALID_BATHROOM_NATSUE, moves(face_up))
    applymovement(LOCALID_BATHROOM_AKIE, moves(face_up))
    applymovement(LOCALID_BATHROOM_KITARO, moves(face_left))
    applymovement(LOCALID_BATHROOM_JOJI, moves(face_left))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    setspeaker("Suzuki")
    msgbox(format("Forgive me. The ship's main breaker had tripped."))
    msgbox(format("I'm no electrician, I couldn't tell you what was wrong with it."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Suzuki")
    msgbox(format("Natsue, {RIVAL}, please see to Ichiro in the Dining Room."))
    msgbox(format("The rest of you, come with me.\pWe can inspect the electrical room together."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_BATHROOM_RAN, moves(face_player))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("Go with them, {PLAYER}. We'll stay with Ichiro."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setflag(FLAG_HIDE_TARC3_BATH_SUZUKI)
    setflag(FLAG_HIDE_TARC3_BATH_FAMILY)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_TO_ELECTRICAL)
    fadescreen(FADE_TO_BLACK)
    warp(MAP_TARC3_ELECTRICAL_ROOM, 9, 4)
    waitstate
    end
}
