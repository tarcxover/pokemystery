mapscripts tarc3_Hold_MapScripts {
    MAP_SCRIPT_ON_LOAD: tarc3_Hold_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_FLORIO_INTRO, 5: tarc3_Hold_EventScript_Arrival
        VAR_TARC3_ACT1, TARC3_ACT1_JAIL_TAKESHI: tarc3_Hold_EventScript_JailTakeshi
        VAR_TARC3_ACT2, TARC3_ACT2_HOLD_SEARCH: tarc3_Hold_EventScript_TakeshiGone
    ]
}

script tarc3_Hold_OnLoad {
    if (var(VAR_TARC3_ACT2) != TARC3_ACT2_HOLD_SEARCH) {
        setflag(FLAG_HIDE_TARC3_HOLD2_CAST)
    }
    if (var(VAR_TARC3_ACT1) >= TARC3_ACT1_COMPLETE) {
        setmetatile(17, 20, 0x07A, TRUE)
    }
    end
}

script tarc3_Hold_EventScript_Arrival {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    delay(30)
    setspeaker("Natsue")
    msgbox(format("The hold isn't much to look at, I'm afraid."))
    msgbox(format("The rest of the family are upstairs.\pI'll show you to your room first."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setflag(FLAG_HIDE_TARC3_HOLD_NATSUE)
    setflag(FLAG_HIDE_TARC3_HOLD_RAN)
    call(tarc3_EventScript_Act1Setup)
    setvar(VAR_TARC3_FLORIO_INTRO, 6)
    warp(MAP_TARC3_MAIN_DECK, 28, 11)
    waitstate
    end
}

// CS6

script tarc3_Hold_EventScript_JailTakeshi {
    lockall
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_HOLD_MARIKO_LOCKUP, moves(walk_down * 2, face_right))
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(walk_down * 2, face_left))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(walk_down, face_down))
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_down * 2, walk_left))
    waitmovement(0)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("The garland was on the floor outside that door.\pIt was there before any of us knew he was dead."))
    setspeaker("Tatsuo")
    msgbox(format("Natsue pinned it to your lapel this afternoon."))
    delay(40)
    msgbox(format("I saw her do it!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("You'd have to be an idiot to drop it right outside his door."))
    setspeaker("Takeshi")
    msgbox(format("I didn't drop it there.\pI lost it somewhere... I don't know where."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_HOLD_JOJI_LOCKUP, moves(walk_in_place_slow_right))
    waitmovement(0)
    setspeaker("Joji")
    msgbox(format("This is a storage hold. We are not a police force."))
    setspeaker("Mariko")
    msgbox(format("I'm sure we could request one. Father had contacts."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(face_up))
    waitmovement(0)
    delay(20)
    setspeaker("Takeshi")
    msgbox(format("Don't.\pI'll go in on my own.\pI'd rather that, than have you all stare at me like this."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(face_down))
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(walk_down))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_HOLD_TAKESHI_LOCKUP)
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_LOCKUP, moves(walk_down, walk_right * 2, walk_down))
    waitmovement(0)
    delay(20)
    playse(SE_BANG)
    delay(30)
    setspeaker("Suzuki")
    msgbox(format("It bolts from this side only. There is no handle on the inside of that door."))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_HOLD_SUZUKI_LOCKUP, moves(walk_up))
    waitmovement(0)
    delay(60)
    setspeaker("Suzuki")
    msgbox(format("While you are all in one place... There is a matter I am obliged to raise."))
    msgbox(format("The master wrote a will.\pHe left everything to Natsue.\pAll assets. All authority."))
    msgbox(format("And the man she chose would lead the Corporation."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_HOLD_MARIKO_LOCKUP, moves(emote_exclamation_mark))
    applymovement(LOCALID_HOLD_AKIE_LOCKUP, moves(emote_exclamation_mark))
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(60)
    applymovement(LOCALID_HOLD_MARIKO_LOCKUP, moves(face_up))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("You can spend whatever you like on your art school now, Ichiro."))
    applymovement(LOCALID_HOLD_ICHIRO_LOCKUP, moves(face_down))
    setspeaker("Ichiro")
    msgbox(format("I... don't really want that."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_HOLD_AKIE_LOCKUP, moves(walk_down, face_left))
    waitmovement(0)
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(face_right))
    waitmovement(0)
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("Tch..."))
    setspeaker("Akie")
    msgbox(format("Say it. You've been waiting all evening to say it."))
    setspeaker("Tatsuo")
    msgbox(format("You think a single one of us would be on this boat if that will didn't exist?"))
    msgbox(format("I married into this family to inherit something.\pThere.\pI said it."))
    msgbox(format("Just like Mr. Zaiki's boy did."))
    setspeaker(NULL)
    closemessage
    delay(30)
    setspeaker("Akie")
    msgbox(format("You..!\pI can't believe you!\pGet away from me!"))
    setspeaker("Tatsuo")
    msgbox(format("Gladly. I'll be on the outer deck."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(walk_up * 4, walk_right))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_HOLD_TATSUO_LOCKUP)
    delay(90)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_HOLD_MARIKO_LOCKUP)
    removeobject(LOCALID_HOLD_KITARO_LOCKUP)
    removeobject(LOCALID_HOLD_JOJI_LOCKUP)
    removeobject(LOCALID_HOLD_AKIE_LOCKUP)
    removeobject(LOCALID_HOLD_ICHIRO_LOCKUP)
    removeobject(LOCALID_HOLD_SUZUKI_LOCKUP)
    applymovement(LOCALID_CAMERA, moves(walk_up * 2, walk_right))
    waitmovement(0)
    special(RemoveCameraObject)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    setspeaker("{RIVAL}")
    msgbox(format("They've locked a man in a storage room on the strength of one flower."))
    msgbox(format("Before we go up. Everything that just got said in here, while it's still straight in your head."))
    setspeaker(NULL)
    closemessage
    call(tarc3_Hold_EventScript_RecapCS5)
    call(tarc3_Hold_EventScript_RecapCS6)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("I'm going to find Natsue.\pSomebody should be with her, and it isn't going to be any of them."))
    msgbox(format("We'll be up by the door out to the deck. Come and find us."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_HOLD_RAN_LOCKUP, moves(walk_left, walk_up * 2, walk_right))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_HOLD_RAN_LOCKUP)
    setflag(FLAG_HIDE_TARC3_LOCKUP_CAST)
    delay(30)
    clearflag(FLAG_HIDE_TARC3_DECKDOOR_CAST)
    clearflag(FLAG_HIDE_TARC3_HOLD_EVD_MANIFEST)
    addobject(LOCALID_HOLD_EVD_MANIFEST)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_COMPLETE)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_DECK_DOOR)
    releaseall
    end
}

// CS6 recap - the reflections on what was said in CS5 and CS6

script tarc3_Hold_EventScript_RecapCS5 {
    goto_if_set(FLAG_TARC3_REFLECT_HOLD_CS5, tarc3_Hold_EventScript_RecapEnd)
    setspeaker(NULL)
    message(format("{FONT_NARROW}(Mariko put all of it in the open upstairs. What was worth keeping?)", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("Takeshi is a Zaiki", 0)
    dynmultipush("Mariko heard them argue", 1)
    dynmultipush("Natsue walked out", 2)
    dynmultipush("Cancel", 3)
    dynmultistack(0, 0, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 0:
            goto(tarc3_Hold_EventScript_RecapHistory)
        case 1:
            goto(tarc3_Hold_EventScript_RecapArgument)
        case 3:
            goto(tarc3_Hold_EventScript_RecapEnd)
        case MULTI_B_PRESSED:
            goto(tarc3_Hold_EventScript_RecapEnd)
        default:
            goto(tarc3_Hold_EventScript_RecapCS5Irrelevant)
    }
}

script tarc3_Hold_EventScript_RecapHistory {
    msgbox(format("{FONT_NARROW}(Gozo took his father's company and the man killed himself over it.)\pTakeshi married into the family that did it.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_HOLD_CS5)
    // giveevidence(EVD_TAKESHIS_HISTORY)
    call(tarc3_EventScript_EvidenceCaptured)
    closemessage
    goto(tarc3_Hold_EventScript_RecapEnd)
}

script tarc3_Hold_EventScript_RecapArgument {
    msgbox(format("{FONT_NARROW}(She stood at that door before dinner and heard her father shouting Takeshi's name.)\pSo she says.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_HOLD_CS5)
    // giveevidence(EVD_OVERHEARD_ARGUMENT)
    call(tarc3_EventScript_EvidenceCaptured)
    closemessage
    goto(tarc3_Hold_EventScript_RecapEnd)
}

script tarc3_Hold_EventScript_RecapCS5Irrelevant {
    msgbox(format("{FONT_NARROW}(I'd have walked out too. It doesn't tell me anything.)", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_HOLD_CS5)
    goto(tarc3_Hold_EventScript_RecapEnd)
}

script tarc3_Hold_EventScript_RecapCS6 {
    goto_if_set(FLAG_TARC3_REFLECT_HOLD_CS6, tarc3_Hold_EventScript_RecapEnd)
    setspeaker(NULL)
    message(format("{FONT_NARROW}(And then Suzuki opened his mouth about the will.)", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("Tatsuo married for money", 0)
    dynmultipush("Joji wanted no part of it", 1)
    dynmultipush("It all goes to Natsue", 2)
    dynmultipush("Cancel", 3)
    dynmultistack(0, 0, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 0:
            goto(tarc3_Hold_EventScript_RecapDebts)
        case 2:
            goto(tarc3_Hold_EventScript_RecapWill)
        case 3:
            goto(tarc3_Hold_EventScript_RecapEnd)
        case MULTI_B_PRESSED:
            goto(tarc3_Hold_EventScript_RecapEnd)
        default:
            goto(tarc3_Hold_EventScript_RecapCS6Irrelevant)
    }
}

script tarc3_Hold_EventScript_RecapDebts {
    msgbox(format("{FONT_NARROW}(He said it to the whole room. He married Akie to inherit, and he isn't sorry.)", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_HOLD_CS6)
    // giveevidence(EVD_TATSUOS_DEBTS)
    call(tarc3_EventScript_EvidenceCaptured)
    closemessage
    goto(tarc3_Hold_EventScript_RecapEnd)
}

script tarc3_Hold_EventScript_RecapWill {
    msgbox(format("{FONT_NARROW}(Every share and every property, to Natsue.)\pAnd three people in that room found out tonight.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_HOLD_CS6)
    // giveevidence(EVD_GOZOS_WILL)
    call(tarc3_EventScript_EvidenceCaptured)
    closemessage
    goto(tarc3_Hold_EventScript_RecapEnd)
}

script tarc3_Hold_EventScript_RecapCS6Irrelevant {
    msgbox(format("{FONT_NARROW}(He kept out of it, at least. That's not worth writing down.)", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_HOLD_CS6)
    goto(tarc3_Hold_EventScript_RecapEnd)
}

script tarc3_Hold_EventScript_RecapEnd {
    return
}

script tarc3_Hold_EventScript_EvdManifest {
    lockall
    msgbox(format("The passenger manifest, hung by the stairs in Kitaro's handwriting."))
    msgbox(format("{FONT_NARROW}(Family, one steward, one cook. The crew are berthed forward and none of them came aft.)", "1_latin_rse_narrow"))
    closemessage
    // giveevidence(EVD_PASSENGER_MANIFEST)
    call(tarc3_EventScript_EvidenceCaptured)
    closemessage
    setflag(FLAG_HIDE_TARC3_HOLD_EVD_MANIFEST)
    removeobject(LOCALID_HOLD_EVD_MANIFEST)
    releaseall
    end
}

// CS8

script tarc3_Hold_EventScript_TakeshiGone {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    delay(40)
    applymovement(LOCALID_HOLD_KITARO_SEARCH, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("Ichiro")
    msgbox(format("Huh? The storage door is wide open."))
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_SEARCH, moves(walk_down))
    waitmovement(0)
    delay(40)
    setspeaker("Suzuki")
    msgbox(format("Empty.\pHis jacket is on the floor and he is not in here."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_SEARCH, moves(walk_up, face_left))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_HOLD_KITARO_SEARCH, moves(walk_in_place_fast_right))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("The bolt isn't broken. Look at it."))
    msgbox(format("It's been drawn back. Slid open, neat as anything."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_MARIKO_SEARCH, moves(walk_in_place_fast_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("There. That is your answer."))
    msgbox(format("He let himself out, he went up on that deck, and he killed Tatsuo."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_SEARCH, moves(face_up))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("Mariko.\pThat door has no handle on the inside."))
    msgbox(format("I bolted it myself. He could not have reached it."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Mariko")
    msgbox(format("Or... You didn't close it correctly."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Suzuki")
    msgbox(format("Forgive me, Mariko. But I did bolt the door myself.\pEveryone had watched me."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}(Then somebody outside this room opened it for him.)", "1_latin_rse_narrow"))
    closemessage
    delay(30)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_HOLD_SUZUKI_SEARCH)
    removeobject(LOCALID_HOLD_NATSUE_SEARCH)
    removeobject(LOCALID_HOLD_COMFEY_SEARCH)
    removeobject(LOCALID_HOLD_MARIKO_SEARCH)
    removeobject(LOCALID_HOLD_KITARO_SEARCH)
    removeobject(LOCALID_HOLD_AKIE_SEARCH)
    removeobject(LOCALID_HOLD_JOJI_SEARCH)
    removeobject(LOCALID_HOLD_ICHIRO_SEARCH)
    setobjectxy(LOCALID_HOLD_RAN_SEARCH, 17, 19)
    applymovement(LOCALID_HOLD_RAN_SEARCH, moves(face_up))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    setspeaker("{RIVAL}")
    msgbox(format("They're going to argue about this for an hour."))
    msgbox(format("I'm going back up to the deck.\pCome and find me there, and we'll look at it properly.")) // placeholder line - Ran & Conan probably want to inspect it immediately?
    setspeaker(NULL)
    closemessage
    delay(30)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_HIDE_TARC3_HOLD2_CAST)
    removeobject(LOCALID_HOLD_RAN_SEARCH)
    clearflag(FLAG_HIDE_TARC3_DECK2_RAN)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_INVESTIGATE_2A)
    fadescreen(FADE_FROM_BLACK)
    delay(20)
    releaseall
    end
}

script tarc3_Hold_EventScript_Ran {
    lock
    faceplayer
    setspeaker("{RIVAL}")
    msgbox(format("The stairs are just over there. Everyone's waiting upstairs, {PLAYER}."))
    setspeaker(NULL)
    release
    end
}
