mapscripts tarc3_MainDeck_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: tarc3_MainDeck_OnTransition
    MAP_SCRIPT_ON_LOAD: tarc3_MainDeck_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_FLORIO_INTRO, 6: tarc3_MainDeck_EventScript_ShowRoom
        VAR_TARC3_ACT1, TARC3_ACT1_DINNER: tarc3_MainDeck_EventScript_Dinner
        VAR_TARC3_ACT2, TARC3_ACT2_ROOM_SETTLES: tarc3_MainDeck_EventScript_RoomSettles
        VAR_TARC3_ACT2, TARC3_ACT2_BLACKOUT: tarc3_MainDeck_EventScript_BlackoutReturn
    ]
}

// force blackout during act 2

script tarc3_MainDeck_OnTransition {
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT && var(VAR_TARC3_ACT2) <= TARC3_ACT2_TO_BATHROOM) {
        setflashlevel(7)
    }
    end
}

script tarc3_MainDeck_OnLoad {
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_DECK_DOOR) {
        clearflag(FLAG_HIDE_TARC3_DECKDOOR_CAST)
    } else {
        setflag(FLAG_HIDE_TARC3_DECKDOOR_CAST)
    }
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_TO_BATHROOM) {
        clearflag(FLAG_HIDE_TARC3_CORRIDOR_RAN)
    } else {
        setflag(FLAG_HIDE_TARC3_CORRIDOR_RAN)
    }
    end
}

script tarc3_MainDeck_EventScript_ShowRoom {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_1, moves(walk_down, walk_left))
    waitmovement(0)
    setspeaker("Natsue")
    msgbox(format("This is your room. Please make yourself at home."))
    msgbox(format("I'll see you later."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_NATSUE_1, moves(walk_left * 11))
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_MAINDECK_NATSUE)
    removeobject(LOCALID_MAINDECK_NATSUE_1)
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_1, moves(face_up))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    setspeaker("Ran")
    msgbox(format("I'll check out the bedroom. You should introduce yourself to the family."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_1, moves(walk_down))
    waitmovement(0)
    playse(SE_EXIT)
    delay(20)
    setflag(FLAG_HIDE_TARC3_MAINDECK_RAN)
    removeobject(LOCALID_MAINDECK_RAN_1)
    delay(30)
    setvar(VAR_TARC3_FLORIO_INTRO, 7)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_Mariko {
    lock
    faceplayer
    setspeaker("Mariko")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Mariko Hatamoto. My husband handles the company. I handle the family."))
        msgbox(format("You'll find we're not much of a wedding party.\pWe travel together perhaps twice a decade, and never happily."))
        msgbox(format("The last time we were all in one room was a funeral.\pMy brother Shoichi and his wife. An accident, a couple years ago."))
        msgbox(format("We're in much better spirits today. It's a good chance to ask Father about..."))
        msgbox(format("Disregard that! This is a family matter."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("So you met my father on the deck. Everybody does, eventually."))
    msgbox(format("He kept Kitaro waiting eleven years before he approved our marriage.\pEleven. And Natsue was engaged inside a month."))
    msgbox(format("He decides who belongs to this family. He always has."))
    setspeaker(NULL)
    closemessage
    msgbox(format("(She counted something on her fingers the entire time she was speaking.)"))
    closemessage
    release
    end
}

script tarc3_MainDeck_EventScript_Akie {
    lock
    faceplayer
    setspeaker("Akie")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Akie. Natsue's sister, before you ask, and no, we're nothing alike."))
        msgbox(format("If you're looking for my husband, don't. He'll find you."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("Yes? No, it's nothing. Family business."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_AKIE, moves(face_left))
    waitmovement(0)
    msgbox(format("(She lowers her voice and turns back to Mariko. Only fragments carry.)"))
    msgbox(format("(...everything goes to... not to the eldest...)"))
    closemessage
    release
    end
}

script tarc3_MainDeck_EventScript_Suzuki {
    lock
    faceplayer
    setspeaker("Suzuki")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Good afternoon. Kenji Suzuki. I look after the household."))
        msgbox(format("Dinner is not far away. You are both expected, whatever anyone tells you otherwise."))
        msgbox(format("The galley is through there, the cabins behind you.\pThe stairs will take you to the hold."))
        msgbox(format("Go where you please. The crew keep to the bridge and their own berths.\pFor this voyage, the ship belongs to the family and nobody else."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("I heard about the deck. Apologies. Gozo speaks his mind with ruthless efficiency.\pIt's how he conducts his business, too."))
    msgbox(format("Lately, Gozo has been considering his family's legacy. Where he allocates his capital and his attention.\pWhat is, and is not, returning on his investments..."))
    msgbox(format("The young man with the sketchbook is not family, before you ask.\pIchiro grew up on Hatamoto Island. He and Natsue played together as children."))
    msgbox(format("Gozo paid for his studies. Art school, on the mainland."))
    msgbox(format("...Gozo tends to feel owed, when he invests in a person."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_Joji {
    lock
    faceplayer
    setspeaker("Joji")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Joji Hatamoto. You might think we're a family of businesspeople.\pI travel the world, cooking only the finest foods."))
        msgbox(format("I run a restaurant back on the mainland. Kalosian cuisine, mostly.\pMy Pokémon assist, of course!"))
        msgbox(format("I carry my own knives everywhere. Eight of them, in a roll.\pA chef who borrows a knife is a chef who has given up."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("You heard him. He won't touch Kalosian food. He never has."))
    msgbox(format("I don't know why I thought a wedding would be any different.\pThe last time was Mariko's reception. He didn't eat then either."))
    msgbox(format("Not a bite. Not even the bread.\pHe says the smell of a Kalosian loaf is enough to turn his stomach."))
    msgbox(format("Anyway. Dinner is nearly up, and I won't have it going cold."))
    msgbox(format("Fetch your friend from your cabin and come through together.\pI'm not sending Suzuki round twice."))
    setspeaker(NULL)
    release
    end
}

// dinner & investigation

script tarc3_MainDeck_EventScript_Dinner {
    lockall
    delay(30)
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(face_up))
    waitmovement(0)
    delay(30)
    setspeaker("Ran")
    msgbox(format("Hmm...\pWe've been sat here half an hour, and I don't think anyone has said a word."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(face_left))
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_right * 2, face_right))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_left))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("Forgive me. I found this in the corridor coming through from the galley.\pOutside Gozo's cabin, I think."))
    msgbox(format("That was a little after seven.\pI have not stepped out of this room since."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Natsue")
    msgbox(format("That's... that's the one I pinned on Takeshi.\pThis afternoon, on the deck."))
    setspeaker(NULL)
    closemessage
    delay(30)
    clearflag(FLAG_HIDE_TARC3_DINING_TAKESHI)
    addobject(LOCALID_MAINDECK_TAKESHI_DINING)
    delay(30)
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(walk_right * 7, walk_down, face_right))
    waitmovement(0)
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_up))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("Takeshi. You've gone completely pale."))
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(walk_in_place_slow_up))
    delay(30)
    msgbox(format("And your garland. When did it come off?"))
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(walk_in_place_slow_down * 2))
    setspeaker("Takeshi")
    msgbox(format("I don't know. I'm sorry."))
    msgbox(format("I've been in our cabin since I left your grandfather. Sitting. Thinking.\pI didn't notice it was gone."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_right))
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(face_right))
    waitmovement(0)
    setspeaker("Ran")
    msgbox(format("My father seems to misplace his possessions constantly."))
    msgbox(format("He's a private detective. Half our conversations at home sound like this one."))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up * 5))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("A detective..?"))
    msgbox(format("Don't repeat that in front of my father.\pPeople who pry into other people's affairs are contemptible, in his words."))
    closemessage
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_up))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("Mariko."))
    setspeaker("Mariko")
    msgbox(format("I'm being kind. He would have said it far worse."))
    setspeaker(NULL)
    closemessage
    delay(40)
    msgbox(format("(The dining room falls silent.)"))
    closemessage
    delay(20)
    applymovement(LOCALID_CAMERA, moves(walk_down * 5))
    waitmovement(0)
    special(RemoveCameraObject)
    delay(30)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_in_place_slow_right))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("Please, talk amongst yourselves.\pI will fetch Gozo."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_left * 7))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    removeobject(LOCALID_MAINDECK_SUZUKI_DINING)
    delay(30)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_DINNER_TABLE)
    releaseall
    end
}

// act 1 dinner conversations

script tarc3_MainDeck_EventScript_DinnerTalkDone {
    if (var(VAR_TARC3_DINNER_TALKED) >= 5) {
        goto(tarc3_MainDeck_EventScript_TheScream)
    }
    release
    end
}

script tarc3_MainDeck_EventScript_DinnerNoExit {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
    waitmovement(0)
    msgbox(format("(Everyone is waiting on Gozo.\pI should talk to the family members to pass the time.)"))
    closemessage
    releaseall
    end
}

script tarc3_MainDeck_EventScript_DiningSuzuki {
    lock
    faceplayer
    setspeaker("Suzuki")
    msgbox(format("Everything is ready, sir.\pIt only wants the master."))
    setspeaker(NULL)
    closemessage
    release
    end
}

script tarc3_MainDeck_EventScript_DiningRan {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_ROOM_SETTLES) {
        setspeaker("Ran")
        msgbox(format("Everyone's accounted for except Takeshi.\pI've been counting heads since we sat down."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker("Ran")
    msgbox(format("Hmm...\pEveryone keeps starting conversations, and then trailing off."))
    msgbox(format("I can't believe how much animosity there is in this room. Money warps relationships."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_RAN)) {
        setflag(FLAG_TARC3_DINNER_TALK_RAN)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningNatsue {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_LEAVING_DINING) {
        msgbox(format("I'm scared..."))
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherNatsue)
    }
    setspeaker("Natsue")
    msgbox(format("Oh... hello.\pTakeshi hasn't said a word since he sat down."))
    msgbox(format("Grandfather asked to speak with him alone.\pThat is never a small thing."))
    msgbox(format("I wish my aunt would stop being so argumentative. At least, pause it for my wedding day."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_NATSUE)) {
        setflag(FLAG_TARC3_DINNER_TALK_NATSUE)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningTakeshi {
    lock
    faceplayer
    setspeaker("Takeshi")
    msgbox(format("...Sorry. I'm poor company tonight."))
    msgbox(format("He knew more about me than I thought.\pThat's all I can say. Please don't ask Natsue."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_TAKESHI)) {
        setflag(FLAG_TARC3_DINNER_TALK_TAKESHI)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningJoji {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherJoji)
    }
    setspeaker("Joji")
    msgbox(format("Well. Nobody has eaten a thing."))
    msgbox(format("Three days I spent on that consommé.\pNot one spoon lifted."))
    msgbox(format("Even Ichiro here, and he always clears his plate.\pThe boy lives on nothing at art school."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_JOJI)) {
        setflag(FLAG_TARC3_DINNER_TALK_JOJI)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningMariko {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherMariko)
    }
    setspeaker("Mariko")
    msgbox(format("Hm? Oh. It's you."))
    msgbox(format("I went down to Father's cabin before dinner.\pHe didn't answer. He does that when he's in a mood."))
    msgbox(format("There's an announcement coming when we dock.\pIf you've any sense, you'll be off this ship before it's made."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_MARIKO)) {
        setflag(FLAG_TARC3_DINNER_TALK_MARIKO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningKitaro {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherKitaro)
    }
    setspeaker("Kitaro")
    msgbox(format("...Three times I've asked to leave the company.\pThree times he's refused me."))
    msgbox(format("I'm no good at it. Everyone knows that.\pHim most of all."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_KITARO)) {
        setflag(FLAG_TARC3_DINNER_TALK_KITARO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningAkie {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherAkie)
    }
    setspeaker("Akie")
    msgbox(format("Hah. Look at my husband.\pHe hasn't turned his head towards me once tonight."))
    msgbox(format("Go on. Ask him what he married me for.\pHe'll tell you. He tells everybody."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_AKIE)) {
        setflag(FLAG_TARC3_DINNER_TALK_AKIE)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningTatsuo {
    lock
    faceplayer
    setspeaker("Tatsuo")
    msgbox(format("See that one? The artist?\pHe's been this family's charity case since he was ten."))
    msgbox(format("Sits there, drawing constantly.\pThe old man funded his education because he is Natsue's friend."))
    msgbox(format("I'm married to his granddaughter! I'm part of the family!\pWhy can't he 'invest' in me too?"))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_TATSUO)) {
        setflag(FLAG_TARC3_DINNER_TALK_TATSUO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningIchiro {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherIchiro)
    }
    setspeaker("Ichiro")
    msgbox(format("Oh. Sorry.\pI have been working on a new sketch."))
    msgbox(format("I stopped to wash my hands on the way.\pI love drawing with charcoal, but it can be messy."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("(He glances down the table at Natsue, then back at his plate.)"))
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_ICHIRO)) {
        setflag(FLAG_TARC3_DINNER_TALK_ICHIRO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

// CS7 (probably a better way to do this)

script tarc3_MainDeck_EventScript_DeckDoorFrom9 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 2, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom10 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 3, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom11 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 4, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom12 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 5, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom13 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 6, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFromStairsA {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFromStairsB {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorScene {
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_MAINDECK_RAN_DECK, moves(face_right))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("I married a man this morning, and now I don't know his name."))
    msgbox(format("Everyone down that corridor decided he was a killer immediately.\pMy aunt has him in a storage hold."))
    msgbox(format("...I left.\pI stood there and I left him."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_DECK, moves(face_up))
    setspeaker("Ran")
    msgbox(format("Conan and I don't think he did it."))
    msgbox(format("Conan thinks the garland didn't fall off him.\pIt was lying flat in the corridor, undamaged.\pSomebody was guaranteed to walk past and notice it."))
    msgbox(format("Somebody put it there. That means somebody wanted him blamed.")) // maybe this should be a conversation the player is able to have with Natsue instead?
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_NATSUE_DECK, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("Then whoever did it is still on this ship with us!"))
    setspeaker("Ran")
    delay(40)
    msgbox(format("Yes.\pThey are."))
    setspeaker(NULL)
    closemessage
    delay(40)
    playse(SE_M_DIVE)
    delay(50)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_MAINDECK_RAN_DECK, moves(face_left))
    applymovement(LOCALID_MAINDECK_NATSUE_DECK, moves(face_left))
    waitmovement(0)
    delay(30)
    playse(SE_BANG)
    delay(40)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("Ran")
    msgbox(format("Did you hear that!?"))
    setspeaker("Natsue")
    msgbox(format("There were two sounds.\pA splash... and a thud."))
    setspeaker(NULL)
    closemessage
    delay(30)
    setspeaker("Ran")
    msgbox(format("They came from outside.\pGo and look, we'll be right behind you."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_BODY_ON_DECK)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_TheScream {
    lockall
    delay(30)
    fadeoutbgm(4)
    delay(120)
    playse(SE_PIN)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(face_left))
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_left))
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(face_left))
    waitmovement(0)
    msgbox(format("Suzuki's voice carries the length of the corridor.\pHe is shouting for someone to come."))
    closemessage
    delay(20)
    setflag(FLAG_HIDE_TARC3_DINING_JOJI)
    setflag(FLAG_HIDE_TARC3_DINING_NATSUE)
    setflag(FLAG_HIDE_TARC3_DINING_TAKESHI)
    setflag(FLAG_HIDE_TARC3_DINING_MARIKO)
    setflag(FLAG_HIDE_TARC3_DINING_KITARO)
    setflag(FLAG_HIDE_TARC3_DINING_AKIE)
    setflag(FLAG_HIDE_TARC3_DINING_TATSUO)
    setflag(FLAG_HIDE_TARC3_DINING_ICHIRO)
    setflag(FLAG_HIDE_TARC3_DINING_RAN)
    clearflag(FLAG_HIDE_TARC3_C1_SUZUKI)
    clearflag(FLAG_HIDE_TARC3_HALL_NATSUE)
    clearflag(FLAG_HIDE_TARC3_HALL_TAKESHI)
    clearflag(FLAG_HIDE_TARC3_HALL_JOJI)
    clearflag(FLAG_HIDE_TARC3_HALL_MARIKO)
    clearflag(FLAG_HIDE_TARC3_HALL_KITARO)
    clearflag(FLAG_HIDE_TARC3_HALL_ICHIRO)
    clearflag(FLAG_HIDE_TARC3_HALL_AKIE)
    clearflag(FLAG_HIDE_TARC3_HALL_TATSUO)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_THE_BODY)
    warp(MAP_TARC3_GOZO_ROOM, 10, 11)
    waitstate
    end
}

// CS9 - investigation

script tarc3_MainDeck_EventScript_RoomSettles {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement(0)
    delay(30)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up * 2))
    waitmovement(0)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("We locked him in a room, and yet he still escaped.\pHe could be anywhere!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("(I should gather evidence from the family.)"))
    closemessage
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_GATHER)
    applymovement(LOCALID_CAMERA, moves(walk_down * 2))
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_GatherTalkDone {
    addvar(VAR_TARC3_GATHER_TALKED, 1)
    if (var(VAR_TARC3_GATHER_TALKED) == 2) {
        goto(tarc3_MainDeck_EventScript_IchiroExcusesHimself)
    }
    if (var(VAR_TARC3_GATHER_TALKED) >= 4) {
        goto(tarc3_MainDeck_EventScript_Blackout)
    }
    release
    end
}

script tarc3_MainDeck_EventScript_IchiroExcusesHimself {
    closemessage
    delay(30)
    applymovement(LOCALID_MAINDECK_ICHIRO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Ichiro")
    msgbox(format("Excuse me... I need to use the bathroom."))
    setspeaker(NULL)
    closemessage
    hidefollower
    delay(20)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    if (var(VAR_TEMP_1) == 44 && var(VAR_TEMP_2) == 9) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right, face_left))
        waitmovement(0)
        delay(10)
    }
    applymovement(LOCALID_MAINDECK_ICHIRO_DINING, moves(walk_down * 2, walk_left * 16))
    waitmovement(0)
    updatefollowingmon
    setflag(FLAG_HIDE_TARC3_DINING_ICHIRO)
    removeobject(LOCALID_MAINDECK_ICHIRO_DINING)
    delay(20)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherAkie {
    setspeaker("Akie")
    if (var(VAR_TARC3_GATHER_AKIE) == 0) {
        msgbox(format("None of this would have happened if she hadn't brought that man into this family."))
        msgbox(format("Natsue chose him.\pShe chose him, and now both my grandfather and my husband are dead."))
        setvar(VAR_TARC3_GATHER_AKIE, 1)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    if (var(VAR_TARC3_GATHER_AKIE) == 1) {
        msgbox(format("And don't look at me as though I'm the only one in here counting."))
        msgbox(format("My aunt wanted her father's money more than any of us.\pShe has never once pretended otherwise."))
        setvar(VAR_TARC3_GATHER_AKIE, 2)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    msgbox(format("Leave me alone. Please."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherMariko {
    setspeaker("Mariko")
    if (var(VAR_TARC3_GATHER_MARIKO) == 0) {
        msgbox(format("Natsue had the most to gain and not one of them will say it out loud."))
        msgbox(format("All of it goes to her.\pEvery share, every property, every last yen."))
        setvar(VAR_TARC3_GATHER_MARIKO, 1)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    if (var(VAR_TARC3_GATHER_MARIKO) == 1) {
        msgbox(format("Before anybody asks me where I was this evening."))
        msgbox(format("Ask Akie who she's been seeing since the spring.\pAsk her whether Tatsuo knew."))
        setvar(VAR_TARC3_GATHER_MARIKO, 2)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    msgbox(format("I've said my piece."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherKitaro {
    setspeaker("Kitaro")
    if (flag(FLAG_TARC3_GATHER_KITARO)) {
        msgbox(format("Not one of us can account for the others.\pThat's the whole of it."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("After they found Father, we all went to our own cabins. Every one of us."))
    msgbox(format("That's where we were when Tatsuo... when it happened.\pNobody can vouch for anybody."))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("You went for a walk."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_up))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("...I did."))
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_down))
    waitmovement(0)
    msgbox(format("I needed time to clear my head.\pEven though Gozo is gone, would Mariko support me if I resigned?"))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_CAMERA, moves(walk_down))
    waitmovement(0)
    special(RemoveCameraObject)
    setflag(FLAG_TARC3_GATHER_KITARO)
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

script tarc3_MainDeck_EventScript_GatherJoji {
    setspeaker("Joji")
    if (var(VAR_TARC3_GATHER_JOJI) == 0) {
        msgbox(format("Nobody in this room should be naming names."))
        msgbox(format("I've been in the galley or in my cabin all evening.\pMy knives haven't left their storage."))
        setvar(VAR_TARC3_GATHER_JOJI, 1)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    if (var(VAR_TARC3_GATHER_JOJI) == 1) {
        msgbox(format("Poor Ichiro...\pFather told him on this ship that he was finished paying for that school.\pSaid it in the open, where people could hear."))
        msgbox(format("Tatsuo thought it was funny.\pHe said so to the boy's face."))
        msgbox(format("We shouldn't treat him as our plaything."))
        setvar(VAR_TARC3_GATHER_JOJI, 2)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    msgbox(format("Let them shout. It'll pass."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherNatsue {
    setspeaker("Natsue")
    if (flag(FLAG_TARC3_GATHER_NATSUE)) {
        msgbox(format("Somebody opened that door.\pThat's the part none of them will look at."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("He was behind a bolted door."))
    msgbox(format("Whatever they've decided he is, he cannot have been in two places."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("That bolt only works from the outside. And nobody forced it."))
    msgbox(format("Takeshi couldn't have let himself out.\pSomeone opened that door for him."))
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up * 2))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Or he had an accomplice."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("We don't know where he is! He could be hurt!"))
    closemessage
    delay(20)
    setspeaker("Mariko")
    msgbox(format("Psh. If we should be so lucky..."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_right))
    waitmovement(0)
    setspeaker("Ran")
    msgbox(format("Don't worry Natsue... We'll prove his innocence."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_CAMERA, moves(walk_down * 2))
    waitmovement(0)
    special(RemoveCameraObject)
    setflag(FLAG_TARC3_GATHER_NATSUE)
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

script tarc3_MainDeck_EventScript_GatherIchiro {
    setspeaker("Ichiro")
    if (flag(FLAG_TARC3_GATHER_ICHIRO)) {
        msgbox(format("...Sorry. I'm not much use tonight."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("Oh. Sorry. I'm finding it hard to focus."))
    msgbox(format("I... I just want to sleep. And be home."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Ichiro")
    msgbox(format("It's not easy to make art in this room."))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_GATHER_ICHIRO)
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

// CS10

script tarc3_MainDeck_EventScript_BlackoutPanToSpeakers {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) < 47 && var(VAR_0x8005) < 13) {
        return
    }
    special(SpawnCameraObject)
    if (var(VAR_0x8004) >= 47) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_left * 6))
        waitmovement(0)
    }
    if (var(VAR_0x8005) >= 13) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_up * 4))
        waitmovement(0)
    }
    return
}

script tarc3_MainDeck_EventScript_BlackoutRestoreCamera {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) < 47 && var(VAR_0x8005) < 13) {
        return
    }
    if (var(VAR_0x8005) >= 13) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_down * 4))
        waitmovement(0)
    }
    if (var(VAR_0x8004) >= 47) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_right * 6))
        waitmovement(0)
    }
    special(RemoveCameraObject)
    return
}

script tarc3_MainDeck_EventScript_Blackout {
    closemessage
    lockall
    delay(30)
    call(tarc3_MainDeck_EventScript_BlackoutPanToSpeakers)
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("Hmm. I think someone should be with Ichiro."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Takeshi could be anywhere!"))
    setspeaker(NULL)
    closemessage
    delay(30)
    // todo: trigger miri's DNS so it goes dark
    fadescreenswapbuffers(FADE_TO_BLACK)
    playse(SE_M_THUNDERBOLT2)
    waitse
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("(The lights...)"))
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    fadescreen(FADE_TO_BLACK)
    call(tarc3_MainDeck_EventScript_BlackoutRestoreCamera)
    delay(30)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_BLACKOUT)
    warp(MAP_TARC3_BATHROOM, 7, 8)
    waitstate
    end
}

script tarc3_MainDeck_EventScript_BlackoutReturn {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement(0)
    delay(20)
    setspeaker("Ran")
    msgbox(format("Conan, come with me. We'll check on him."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(face_up))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("I'll see to the power breaker downstairs."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(walk_faster_up * 3, walk_faster_left * 4, face_left))
    waitmovement(0)
    delay(20)
    setspeaker("Ran")
    msgbox(format("The bathrooms are at the far end of the corridor.\pWe must stay close."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_LEAVING_DINING)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_SuzukiLeaves {
    lockall
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_up * 6, walk_left, walk_up))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    removeobject(LOCALID_MAINDECK_SUZUKI_DINING)
    delay(20)
    playse(SE_M_CUT)
    delay(60)
    msgbox(format("(That came from the bathrooms!)"))
    closemessage
    delay(20)
    setspeaker("Ran")
    msgbox(format("That's Ichiro!"))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(walk_left * 6))
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_DINING_RAN)
    removeobject(LOCALID_MAINDECK_RAN_DINING)
    clearflag(FLAG_HIDE_TARC3_CORRIDOR_RAN)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_TO_BATHROOM)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_CorridorRan {
    lock
    faceplayer
    setspeaker("Ran")
    msgbox(format("I'll wait here for the others."))
    msgbox(format("You go in, Conan. I'll bring the others."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherNoExit {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
    waitmovement(0)
    msgbox(format("(Nobody is leaving this room while they're still going at each other.\pI should hear the rest of it.)"))
    closemessage
    releaseall
    end
}
