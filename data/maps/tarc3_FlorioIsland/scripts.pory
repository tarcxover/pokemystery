mapscripts tarc3_FlorioIsland_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_FLORIO_INTRO, 0: tarc3_FlorioIsland_EventScript_OpeningCutscene
        VAR_TARC3_FLORIO_INTRO, 4: tarc3_FlorioIsland_EventScript_ShipDeparts
    ]
}

script tarc3_FlorioIsland_EventScript_OpeningCutscene {
    lockall
    setflag(FLAG_SYS_POKEMON_GET)
    delay(30)
    waitmovement(0)
    setspeaker("Ran")
    msgbox(format("{PLAYER}! Tell me that isn't our ferry leaving!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_faster_down * 15))
    waitmovement(0)
    delay(30)
    playse(SE_SHIP)
    applymovement(LOCALID_FLORIO_SSHANA, tarc3_FlorioIsland_Movement_ShipDeparts)
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_FLORIO_SSHANA)
    removeobject(LOCALID_FLORIO_SSHANA)
    delay(30)
    applymovement(LOCALID_CAMERA, moves(walk_faster_up * 15))
    waitmovement(0)
    special(RemoveCameraObject)
    delay(20)
    setspeaker("Ran")
    msgbox(format("It's gone...\pAnd that was the last one until tomorrow!"))
    setspeaker(NULL)
    msgbox(format("(We've lost our ride home. There has to be another way off this island...)"))
    setspeaker("Ran")
    msgbox(format("You've talked about nothing but this island's Pokémon all morning.\pGo and look at them. We're not going anywhere."))
    msgbox(format("I'll ask around the pier and find us a way home.\pCome and find me down at the dock when you're done."))
    setspeaker(NULL)
    msgbox(format("(Ran's on the case, then. And I still haven't caught a single Pokémon...)"))
    closemessage
    applymovement(LOCALID_FLORIO_RAN_1, moves(walk_down * 7))
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_FLORIO_RAN)
    removeobject(LOCALID_FLORIO_RAN_1)
    delay(20)
    setvar(VAR_TARC3_FLORIO_INTRO, 1)
    releaseall
    end
}

script tarc3_FlorioIsland_EventScript_CatchDachsbun {
    lock
    faceplayer
    playmoncry(SPECIES_DACHSBUN, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("This Dachsbun doesn't seem afraid at all.\pAdd Dachsbun to the party?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The Dachsbun looks disappointed."))
        release
        end
    }
    givemon(SPECIES_DACHSBUN, 50)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Dachsbun to the party!"))
    waitfanfare
    setflag(FLAG_HIDE_TARC3_FLORIO_DACHSBUN)
    removeobject(LOCALID_FLORIO_DACHSBUN)
    goto(tarc3_FlorioIsland_EventScript_AfterCatch)
}

script tarc3_FlorioIsland_EventScript_CatchTangrowth {
    lock
    faceplayer
    playmoncry(SPECIES_TANGROWTH, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("Tangrowth realises {PLAYER} doesn't mean harm.\pAdd Tangrowth to the party?"), MSGBOX_YESNO)
