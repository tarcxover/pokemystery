        msgbox(format("The Tangrowth looks uneasy..."))
        release
        end
    }
    givemon(SPECIES_TANGROWTH, 50)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Tangrowth to the party!"))
