script tarc3_FlorioIsland_EventScript_CatchCramorant {
    lock
    faceplayer
    playmoncry(SPECIES_CRAMORANT, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("A Cramorant waddles up from the shoreline.\pIt tilts its head at {PLAYER} expectantly.\pAdd Cramorant to the party?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The Cramorant caws indignantly."))
        playmoncry(SPECIES_CRAMORANT, CRY_MODE_ENCOUNTER)
        waitmoncry
        release
        end
    }
    givemon(SPECIES_CRAMORANT, 50)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Cramorant to the party!"))
    waitfanfare
    setflag(FLAG_HIDE_TARC3_FLORIO_CRAMORANT)
    removeobject(LOCALID_FLORIO_CRAMORANT)
    goto(tarc3_FlorioIsland_EventScript_AfterCatch)
}

script tarc3_FlorioIsland_EventScript_CatchToxicroak {
    lock
    faceplayer
    playmoncry(SPECIES_TOXICROAK, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("A Toxicroak croaks, its throat pouch swelling.\pAdd Toxicroak to the party?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The Toxicroak turns away."))
        applymovement(LOCALID_FLORIO_TOXICROAK, Common_Movement_FaceAwayPlayer)
        release
        end
    }
    givemon(SPECIES_TOXICROAK, 50)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Toxicroak to the party!"))
    waitfanfare
    setflag(FLAG_HIDE_TARC3_FLORIO_TOXICROAK)
    removeobject(LOCALID_FLORIO_TOXICROAK)
    goto(tarc3_FlorioIsland_EventScript_AfterCatch)
}

script tarc3_FlorioIsland_EventScript_CatchPincurchin {
    lock
    faceplayer
    playmoncry(SPECIES_PINCURCHIN, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("A Pincurchin clings to a tide pool rock.\pIts spines crackle faintly with static as {PLAYER} approaches.\pAdd Pincurchin to the party?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The Pincurchin stays fixed to its rock."))
        release
        end
    }
    givemon(SPECIES_PINCURCHIN, 50)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Pincurchin to the party!"))
    waitfanfare
    setflag(FLAG_HIDE_TARC3_FLORIO_PINCURCHIN)
    removeobject(LOCALID_FLORIO_PINCURCHIN)
    goto(tarc3_FlorioIsland_EventScript_AfterCatch)
}

script tarc3_FlorioIsland_EventScript_AfterCatch {
    if (getpartysize() < 3) {
        release
        end
    }
    msgbox(format("(That's three of them.\pRan's had long enough to work her magic. Time to head back to the dock.)"))
    closemessage
    setflag(FLAG_HIDE_TARC3_FLORIO_DACHSBUN)
    setflag(FLAG_HIDE_TARC3_FLORIO_TANGROWTH)
    setflag(FLAG_HIDE_TARC3_FLORIO_MAGNEZONE)
    setflag(FLAG_HIDE_TARC3_FLORIO_CRAMORANT)
    setflag(FLAG_HIDE_TARC3_FLORIO_TOXICROAK)
    setflag(FLAG_HIDE_TARC3_FLORIO_PINCURCHIN)
    removeobject(LOCALID_FLORIO_DACHSBUN)
    removeobject(LOCALID_FLORIO_TANGROWTH)
    removeobject(LOCALID_FLORIO_MAGNEZONE)
    removeobject(LOCALID_FLORIO_CRAMORANT)
    removeobject(LOCALID_FLORIO_TOXICROAK)
    removeobject(LOCALID_FLORIO_PINCURCHIN)
    setobjectxyperm(LOCALID_FLORIO_RAN_1, 17, 34)
    setobjectmovementtype(LOCALID_FLORIO_RAN_1, MOVEMENT_TYPE_FACE_LEFT)
    setobjectmovementtype(LOCALID_FLORIO_NATSUE, MOVEMENT_TYPE_FACE_RIGHT)
    clearflag(FLAG_HIDE_TARC3_FLORIO_RAN)
    setvar(VAR_TARC3_FLORIO_INTRO, 2)
    release
    end
}

script tarc3_FlorioIsland_EventScript_DockBlock {
    lockall
    if (var(VAR_TARC3_FLORIO_INTRO) == 1) {
        msgbox(format("(Ran's still asking around for a way home. I should take a proper look at the island while she does.)"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up))
        waitmovement(0)
        releaseall
        end
    }
    if (var(VAR_TARC3_FLORIO_INTRO) == 2) {
        goto(tarc3_FlorioIsland_EventScript_NatsueInvitation)
    }
    releaseall
    end
}

script tarc3_FlorioIsland_EventScript_NatsueInvitation {
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_FLORIO_RAN_1, moves(walk_up))
    applymovement(LOCALID_FLORIO_NATSUE, moves(walk_up))
    waitmovement(0)
    setspeaker("Ran")
    msgbox(format("There you are.\pI was about to send the dockhand up the hill after you."))
    msgbox(format("Natsue's spent the last hour listening to me complain about our ferry.\pAnd she's made us an offer. I could hardly believe it."))
    setspeaker("Natsue")
    msgbox(format("Please, travel with us.\pThat's our ship at the end of the pier. The SS Hana."))
    msgbox(format("She's a private charter.\pThere's more room aboard than we know what to do with. It's no trouble at all."))
    applymovement(LOCALID_FLORIO_RAN_1, moves(face_left))
    waitmovement(0)
    setspeaker("Ran")
    msgbox(format("Are you certain? We couldn't possibly impose on you like that..."))
    applymovement(LOCALID_FLORIO_NATSUE, moves(face_right))
    waitmovement(0)
    setspeaker("Natsue")
    msgbox(format("I'd feel far worse leaving you on an empty pier.\pPlease."))
    setspeaker("Ran")
    msgbox(format("Then... thank you. Truly. We're in your debt."))
    setspeaker("Natsue")
    msgbox(format("I'll have you both added to the ship's manifest. Come and find me inside when you're ready to depart."))
    closemessage
    delay(20)
    applymovement(LOCALID_FLORIO_NATSUE, moves(walk_down * 3, walk_right, walk_down))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_FLORIO_NATSUE)
    removeobject(LOCALID_FLORIO_NATSUE)
    delay(30)
    applymovement(LOCALID_FLORIO_RAN_1, moves(face_up))
    waitmovement(0)
    setspeaker("Ran")
    msgbox(format("Well. That's one problem solved.\pDon't keep her waiting, {PLAYER}. I'll go on ahead and see to our things."))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_FLORIO_RAN_1, moves(walk_down * 3))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_FLORIO_RAN)
    removeobject(LOCALID_FLORIO_RAN_1)
    delay(30)
    setvar(VAR_TARC3_FLORIO_INTRO, 3)
    releaseall
    end
}

script tarc3_FlorioIsland_EventScript_ShipDeparts {
    lockall
    hideplayer
    delay(60)
    playse(SE_SHIP)
    delay(60)
    applymovement(LOCALID_FLORIO_SSHANA, tarc3_FlorioIsland_Movement_ShipDeparts)
    waitmovement(0)
    removeobject(LOCALID_FLORIO_SSHANA)
    delay(30)
    showplayer
    setflag(FLAG_HIDE_TARC3_LOCKUP_CAST)
    setvar(VAR_TARC3_FLORIO_INTRO, 5)
    warp(MAP_TARC3_HOLD, 13, 16)
    waitstate
    end
}

movement tarc3_FlorioIsland_Movement_ShipDeparts {
    walk_slow_left * 3
    walk_left * 3
    walk_fast_left * 3
    walk_faster_left * 12
}

script tarc3_FlorioIsland_EventScript_Dockhand {
    lock
    faceplayer
    msgbox(format("Her? That one at the end of the pier?\pShe's the SS Hana. A Hatamoto Corp private charter."))
    msgbox(format("Their whole family is aboard. They came all the way here for Natsue's wedding."))
    release
    end
}
